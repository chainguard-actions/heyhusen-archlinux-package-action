# Maintainer: Test User <test@example.com>
pkgname=hello-world
pkgver=1.0.0
pkgrel=1
pkgdesc="A minimal test package"
arch=('any')
license=('MIT')
depends=()
makedepends=()
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/share/$pkgname"
    echo "Hello, World!" > "$pkgdir/usr/share/$pkgname/hello.txt"
}
